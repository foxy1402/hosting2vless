# Route every request (plain HTTP and WebSocket upgrades) from Apache to the
# site service on its internal port. Keep this file in public_html.
#
# The service listens on PORT from app.js (default 28741). If you change PORT
# there, change it in both lines below (and in health.sh).
RewriteEngine On

# The server-side dependency folder is never a public page.
RewriteRule ^node_modules(/|$) - [F,L]

RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteRule ^(.*)$ http://127.0.0.1:28741/$1 [P,L]
RewriteRule ^(.*)$ http://127.0.0.1:28741/$1 [P,L]

# Idle upgraded (WebSocket) connections: do not let the default 60-second
# proxy timeout cut them — a live channel is usually quiet for a while.
ProxyTimeout 600

# Extra insurance: if the routing rules above are ever disabled, keep the
# server-side files from being served directly. (While the service is up it
# answers every request itself; while it is down, Apache returns 503.)
<FilesMatch "^(package\.json|package-lock\.json|config\.txt|site\.(log|pid)|app\.js|setup\.sh|health\.sh)$">
  Require all denied
</FilesMatch>
